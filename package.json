{
  "name": "@nandenjin/shinshi",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lintfix": "eslint --fix .",
    "typecheck": "run-p typecheck:*",
    "typecheck:app": "tsc --project tsconfig.app.json --noEmit",
    "typecheck:worker": "tsc --project tsconfig.worker.json --noEmit",
    "typecheck:node": "tsc --project tsconfig.node.json --noEmit"
  },
  "keywords": [],
  "author": "Kazumi Inada a.k.a. Utage <hello@nandenjin.com>",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "lint-staged": "17.3.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "private": true,
  "dependencies": {
    "manifold-3d": "3.5.1",
    "three": "0.185.1",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.14",
    "vue": "3.5.39"
  }
}
